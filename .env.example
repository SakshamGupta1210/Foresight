# FORESIGHT Environment Configuration
HOST=0.0.0.0
PORT=8000

# Security & Session Settings
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Optional Threat Intelligence Feeds
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
URLHAUS_API_KEY=your_urlhaus_api_key_here

# Database
# Leave MONGODB_URI empty to use local SQLite (foresight.db).
# Set it to use MongoDB Atlas (required on Vercel, since its filesystem is not persistent).
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/foresight?retryWrites=true&w=majority
MONGODB_URI=
